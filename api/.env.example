# Local (MinIO) : S3_PUBLIC_URL inclut le bucket dans le chemin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=heyama-objects
S3_PUBLIC_URL=http://localhost:9000/heyama-objects
S3_REGION=us-east-1
MONGO_URI=mongodb://localhost:27017/heyama
PORT=3000

# Cloudflare R2 (prod) : S3_PUBLIC_URL = URL r2.dev de la bucket (deja scopee, pas de bucket dans le chemin)
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<r2 access key id>
# S3_SECRET_KEY=<r2 secret access key>
# S3_BUCKET=heyama-objects
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev
# S3_REGION=auto
